#!/usr/bin/env python3
"""flowforge CLI wrapper that runs from a checkout, with nothing installed.

    ./tools/flowforge --demo
    ./tools/flowforge validate examples/workflows/nightly_report.yaml
"""

from __future__ import annotations

import os
import sys

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SRC = os.path.join(REPO_ROOT, "src")
if SRC not in sys.path:
    sys.path.insert(0, SRC)

from flowforge.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
